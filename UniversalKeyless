	NotifyLabel.TextSize = 13
	NotifyLabel.Font = Enum.Font.GothamMedium
	NotifyLabel.TextWrapped = true
	NotifyLabel.TextXAlignment = Enum.TextXAlignment.Left
	NotifyLabel.TextTransparency = 1

	TweenService:Create(NotifyFrame, TweenInfo.new(0.4, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Position = UDim2.new(1, -310, 0.5, 0) }):Play()
	task.wait(0.15)
	TweenService:Create(NotifyLabel, TweenInfo.new(0.3), { TextTransparency = 0 }):Play()

	task.wait(3.5)

	TweenService:Create(NotifyLabel, TweenInfo.new(0.2), { TextTransparency = 1 }):Play()
	TweenService:Create(NotifyFrame, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In), { Position = UDim2.new(1, 10, 0.5, 0) }):Play()
	task.wait(0.35)
	NotifyFrame:Destroy()
end

