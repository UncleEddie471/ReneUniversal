local function VerifyGroup()
	local input = IDTextBox.Text
	if input == "" then
		ShowNotification("Join First Before You Add ID", Theme.Yellow)
		return
	end
	if input == GroupID then
		ShowNotification("Group Verified Access Granted", Theme.Green)
		StatusLabel.Text = "Group Verified Access Granted"
		StatusLabel.TextColor3 = Theme.Green
		VerifyButton.Text = "Verified"
		VerifyButton.BackgroundColor3 = Theme.Green
		print("[Nowms Hub] Verified Access Granted")
		task.wait(1.5)
		VerifyButton.Text = "Verify Group"
		VerifyButton.BackgroundColor3 = Theme.Primary
		StatusLabel.Text = ""
		return
	end
	ShowNotification("Not Joined Yet Try Again", Theme.Red)
	StatusLabel.Text = "Not Joined Yet Try Again"
	StatusLabel.TextColor3 = Theme.Red
	VerifyButton.BackgroundColor3 = Theme.Red
	for i = 1, 5 do
		local offset = i % 2 ~= 0 and 6 or -6
		TweenService:Create(IDTextBox, TweenInfo.new(0.05), {Position = UDim2.new(0, 20 + offset, 0, 208)}):Play()
		task.wait(0.05)
	end
	TweenService:Create(IDTextBox, TweenInfo.new(0.1), {Position = UDim2.new(0, 20, 0, 208)}):Play()
	task.wait(0.8)
	VerifyButton.BackgroundColor3 = Theme.Primary
	StatusLabel.Text = ""
end

